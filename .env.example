# File: .env.example
# Purpose: Document the environment variables needed for models, sandbox access, and deployment metadata.
# Problem solved: Lets contributors configure a working local environment without exposing real credentials.

# Local `pnpm dev` Project Claude only; hosted production is always BYOK-only.
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_BASE_URL=https://www.packyapi.ai/v1
ANTHROPIC_MODEL=claude-sonnet-4-6
SANDBOX_SNAPSHOT_ID=your_snapshot_id
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Auth handled by `vercel link && vercel env pull` (VERCEL_OIDC_TOKEN) or:
# VERCEL_TOKEN=your_vercel_token
# VERCEL_TEAM_ID=your_vercel_team_id
# VERCEL_PROJECT_ID=your_vercel_project_id
