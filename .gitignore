# File: .gitignore
# Purpose: Define repository exclusions for generated, local, secret, and dependency files.
# Problem solved: Keeps commits reviewable while preventing credentials and build artifacts from being tracked.

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-cli
/playwright-report
/test-results

# local presentation notes
/docs/five-minute-demo-script.en.md
/docs/project-origin-and-walkthrough.zh-CN.md
/docs/repo-wiki.zh-CN.md

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local
.env*
